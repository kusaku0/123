# The website needs no tokens, Telegram, VPN or user proxy.
CITY=Липецк
AVITO_CITY=lipetsk
# Optional explicit WB destination ID for your delivery address.
# If absent, the bot attempts the WB geo endpoint for Lipetsk.
WB_DEST=
WB_LATITUDE=52.6088
WB_LONGITUDE=39.5992
# Use an installed system Chromium, or run: uv run playwright install chromium
BROWSER_EXECUTABLE=
SOURCE_TIMEOUT=35
CACHE_TTL=180
USER_COOLDOWN=10
MAX_CONCURRENT_SEARCHES=2
MAX_CACHE_ENTRIES=128

# Optional legacy Telegram mode only (not used by priceweb):
BOT_TOKEN=
# Empty means the optional Telegram bot is available to everyone.
ALLOWED_USER_IDS=
